+// Full-tooltip fallback for stats that never reach BHOnPropertyBuild.
+static void AppendStatRanges(UnitAny* pItem, wchar_t* wTxt)
+{
+	if (!pItem || !pItem->pItemData || !wTxt) { return; }
+
+	ItemsTxtStat* pStats = nullptr;
+	int nStats = 0;
+	std::vector<ItemsTxtStat> affixStats;
+
+	switch (pItem->pItemData->dwQuality)
+	{
+	case ITEM_QUALITY_SET:
+	{
+		SetItemsTxt* pTxt = &(*p_D2COMMON_sgptDataTable)->pSetItemsTxt[pItem->pItemData->dwFileIndex];
+		if (pTxt) { pStats = pTxt->hStats; nStats = 19; }
+		break;
+	}
+	case ITEM_QUALITY_UNIQUE:
+	{
+		UniqueItemsTxt* pTxt = &(*p_D2COMMON_sgptDataTable)->pUniqueItemsTxt[pItem->pItemData->dwFileIndex];
+		if (pTxt) { pStats = pTxt->hStats; nStats = 12; }
+		break;
+	}
+	case ITEM_QUALITY_MAGIC:
+	case ITEM_QUALITY_RARE:
+	case ITEM_QUALITY_CRAFT:
+	{
+		WORD ids[] = { pItem->pItemData->wPrefix[0], pItem->pItemData->wPrefix[1], pItem->pItemData->wPrefix[2],
+			pItem->pItemData->wSuffix[0], pItem->pItemData->wSuffix[1], pItem->pItemData->wSuffix[2], pItem->pItemData->wAutoPrefix };
+		for (WORD id : ids)
+		{
+			if (!id || id == 0xFFFF) { continue; }
+			AutoMagicTxt* affix = D2COMMON_GetItemMagicalMods(id);
+			if (!affix) { continue; }
+			for (const ItemsTxtStat& mod : affix->hMods)
+			{
+				if (mod.dwProp == 0xFFFFFFFF) { break; }
+				affixStats.push_back(mod);
+			}
+		}
+		if (!affixStats.empty()) { pStats = affixStats.data(); nStats = (int)affixStats.size(); }
+		break;
+	}
+	default:
+		if (pItem->pItemData->dwFlags & ITEM_RUNEWORD)
+		{
+			RunesTxt* pTxt = GetRunewordTxtById(pItem->pItemData->wPrefix[0]);
+			if (pTxt) { pStats = pTxt->hStats; nStats = 7; }
+		}
+		break;
+	}
+
+	if (pStats == nullptr) { return; }
+
+	// DIAG: record what this item offered, once per quality, so a silent no-op is visible.
+	{
+		static bool seenQ[16] = {};
+		int q = (int)pItem->pItemData->dwQuality;
+		if (q >= 0 && q < 16 && !seenQ[q]) {
+			seenQ[q] = true;
+			FILE* t = nullptr;
+			if (fopen_s(&t, "C:\\Diablo II - Lord of Destruction\\ProjectD2\\pd2logs\\bh_ranges.log", "a") == 0) {
+				fprintf(t, "CALL quality=%d nStats=%d |", q, nStats);
+				for (int i = 0; i < nStats; ++i) {
+					if (pStats[i].dwProp == 0xffffffff) break;
+					fprintf(t, " [%d prop=%u par=%u min=%d max=%d]", i, pStats[i].dwProp, pStats[i].dwPar, pStats[i].dwMin, pStats[i].dwMax);
+				}
+				fprintf(t, "\n");
+				fclose(t);
+			}
+		}
+	}
+
+	// Copy the colour codes into locals: GetColorCode() returns a temporary, so holding c_str()
+	// from it across the loop below would be a dangling pointer.
+	std::wstring darkGreenStr = GetColorCode(TextColor::DarkGreen);
+	std::wstring defaultColor = GetColorCode(TextColor::Blue);
+	const wchar_t* darkGreen = darkGreenStr.c_str();
+
+	for (int i = 0; i < nStats; ++i)
+	{
+		if (pStats[i].dwProp == 0xffffffff || pStats[i].dwProp >= (*p_D2COMMON_sgptDataTable)->dwProportiesRecs) { continue; }
+
+		// Fixed values have nothing to show - "[6 - 6]" is only noise.
+		if (pStats[i].dwMin >= pStats[i].dwMax) { continue; }
+
+		PropertiesTxt* pProp = &(*p_D2COMMON_sgptDataTable)->pPropertiesTxt[pStats[i].dwProp];
+		if (pProp == nullptr) { break; }
+
+		// Use the first stat of the property; that is the one that produces the displayed text.
+		// Functions 15/16 are the elemental min/max pair, already handled by the damage callback.
+		for (int j = 0; j < 7; ++j)
+		{
+			WORD statId = pProp->wStat[j];
+			if (statId == 0xFFFF) { break; }
+			if (pProp->nFunc[j] == 15 || pProp->nFunc[j] == 16) { continue; }
+
+			int rolled = (int)D2COMMON_GetUnitStat(pItem, statId, (int)pStats[i].dwPar);
+
+			// DIAG: per-stat lookup result, once per (quality, prop). This is what tells us whether a
+			// missing range is "stat read as 0" or "number not found in the text".
+			{
+				static bool seenS[16][64] = {};
+				int q = (int)pItem->pItemData->dwQuality;
+				if (q >= 0 && q < 16 && i >= 0 && i < 64 && !seenS[q][i]) {
+					seenS[q][i] = true;
+					FILE* t = nullptr;
+					if (fopen_s(&t, "C:\\Diablo II - Lord of Destruction\\ProjectD2\\pd2logs\\bh_ranges.log", "a") == 0) {
+						fprintf(t, "LOOK q=%d i=%d prop=%u par=%u min=%d max=%d statId=%u func=%u rolled=%d\n",
+							q, i, pStats[i].dwProp, pStats[i].dwPar, pStats[i].dwMin, pStats[i].dwMax,
+							statId, pProp->nFunc[j], rolled);
+						fclose(t);
+					}
+				}
+			}
+
+			if (statId == STAT_MAXHP || statId == STAT_MAXMANA) { rolled /= 256; }
+			if (statId == STAT_ENHANCEDDEFENSE || statId == STAT_ENHANCEDMAXIMUMDAMAGE || statId == STAT_ENHANCEDMINIMUMDAMAGE)
+			{
+				StatList* list = D2COMMON_GetStatList(pItem, NULL, 0x40);
+				if (list) { rolled = D2COMMON_GetStatValueFromStatList(list, statId, 0); }
+			}
+			if (rolled == 0) { continue; }
+
+			wchar_t valStr[24];
+			swprintf_s(valStr, 24, L"%d", rolled);
+			size_t valLen = wcslen(valStr);
+
+			// Locate the property line that owns this value, then append the range at the END of that
+			// line. Appending at the end rather than straight after the digits matters for stats
+			// written like "39% Extra Gold" - inserting after the digits would split the number from
+			// its percent sign and leave "39 [37 - 67]% Extra Gold".
+			//
+			// Candidate rejection rules, each one fixing a bug seen in game:
+			//  * a match inside a colour code. Codes are the triple { 0xFF, 'c', X } and X is often a
+			//    digit, so searching for "8" matches the '8' inside "orange". Injecting there splits
+			//    the code and recolours the rest of the tooltip.
+			//  * lines containing ':' or '('. Those are the header and the upgrade-recipe block
+			//    (Defense, iLVL, "Requires: Lvl 50", "Socketed (2)"), all full of numbers.
+			//  * lines containing " + " or " * " with spaces on both sides, which only the recipe
+			//    separator uses ("This Item + Ko + Lem + Perf 6"). Real properties are written as
+			//    "+21" with no space after the sign.
+			//  * lines already carrying '[' so nothing is annotated twice.
+			wchar_t* targetLineEnd = nullptr;
+			// Search from the start of the text on every property, not from a moving cursor.
+			// The tooltip does not list properties in stat-table order (and awakened/corrupted stats
+			// are appended at the end), so a forward-only cursor silently skipped any property that
+			// appeared earlier in the text than in the table - that is why only some lines of an
+			// item ever got a range. The "already annotated" check below prevents double-insertion.
+			for (wchar_t* scan = wTxt; (scan = wcsstr(scan, valStr)) != nullptr; ++scan)
+			{
+				if (scan >= wTxt + 3 && scan[-3] == 0xFF && scan[-2] == L'c') { continue; }
+				if (scan >= wTxt + 2 && scan[-2] == 0xFF && scan[-1] == L'c') { continue; }
+				if (scan >= wTxt + 1 && scan[-1] == 0xFF) { continue; }
+
+				wchar_t before = (scan == wTxt) ? L'\0' : scan[-1];
+				if (before >= L'0' && before <= L'9') { continue; }
+
+				wchar_t after = scan[valLen];
+				if (after >= L'0' && after <= L'9') { continue; }
+
+				wchar_t* lineStart = scan;
+				while (lineStart > wTxt && lineStart[-1] != L'\n') { --lineStart; }
+				wchar_t* lineStop = wcschr(scan, L'\n');
+				size_t thisLineLen = lineStop ? (size_t)(lineStop - lineStart) : wcslen(lineStart);
+
+				bool unusable = false;
+				for (size_t k = 0; k < thisLineLen; ++k)
+				{
+					wchar_t c = lineStart[k];
+					if (c == L'[' || c == L':' || c == L'(' || c == L')') { unusable = true; break; }
+					if (c == L'+' || c == L'*')
+					{
+						bool spBefore = (k > 0 && lineStart[k - 1] == L' ');
+						bool spAfter = (k + 1 < thisLineLen && lineStart[k + 1] == L' ');
+						if (spBefore && spAfter) { unusable = true; break; }
+					}
+				}
+				if (unusable || !StatRangeLineMatches(statId, lineStart, thisLineLen)) { continue; }
+
+				targetLineEnd = lineStop ? lineStop : (lineStart + thisLineLen);
+				break;
+			}
+			if (targetLineEnd == nullptr) { continue; }
+
+			size_t pos = (size_t)(targetLineEnd - wTxt);
+
+			// Restore the colour that was active on this line, rather than forcing white. Forcing
+			// white is what recoloured every affix after the annotated line - the tooltip relies on
+			// colour codes persisting across newlines.
+			std::wstring resume;
+			for (size_t k = pos; k >= 3; --k)
+			{
+				if (wTxt[k - 3] == 0xFF && wTxt[k - 2] == L'c')
+				{
+					resume.assign(wTxt + k - 3, 3);
+					break;
+				}
+			}
+			if (resume.empty()) { resume = defaultColor; }
+
+			wchar_t rangeStr[64];
+			swprintf_s(rangeStr, 64, L" %s[%d - %d]%s", darkGreen, pStats[i].dwMin, pStats[i].dwMax, resume.c_str());
+			size_t rangeLen = wcslen(rangeStr);
+
+			size_t restLen = wcslen(wTxt + pos);
+			if ((pos + rangeLen + restLen) >= ITEM_TEXT_SIZE_LIMIT) { break; }
+
+			memmove(wTxt + pos + rangeLen, wTxt + pos, (restLen + 1) * sizeof(wchar_t));
+			wmemcpy(wTxt + pos, rangeStr, rangeLen);
+
+			break;
+		}
+	}
+}
