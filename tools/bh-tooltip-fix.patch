+// Match localized stat labels as well as values: unrelated stats can have identical rolls.
+static std::wstring StatRangeLabel(const wchar_t* text, size_t length)
+{
+	std::wstring result;
+	for (size_t i = 0; i < length && text[i]; ++i)
+	{
+		if (text[i] == 0xFF && i + 2 < length && text[i + 1] == L'c') { i += 2; continue; }
+		if (text[i] == L'%')
+		{
+			size_t end = i + 1;
+			while (end < length && (text[end] == L'+' || text[end] == L'-' || text[end] == L'.' || (text[end] >= L'0' && text[end] <= L'9'))) { ++end; }
+			if (end < length && (text[end] == L'd' || text[end] == L's' || text[end] == L'u')) { i = end; }
+			continue;
+		}
+		wchar_t c = text[i];
+		if (c >= L'A' && c <= L'Z') { c += L'a' - L'A'; }
+		if ((c >= L'a' && c <= L'z') || c > 0xFF) { result += c; }
+	}
+	return result;
+}
+
+static bool StatRangeLineMatches(WORD statId, const wchar_t* line, size_t length)
+{
+	auto* table = *p_D2COMMON_sgptDataTable;
+	if (statId >= table->dwItemStatCostRecs) { return false; }
+	const ItemStatCostTxt& cost = table->pItemStatCostTxt[statId];
+	WORD labels[] = { cost.wDescStrPos, cost.wDescStrNeg, cost.wDGrpStrPos, cost.wDGrpStrNeg };
+	std::wstring actual = StatRangeLabel(line, length);
+	for (WORD id : labels)
+	{
+		if (!id || id == 0xFFFF) { continue; }
+		const wchar_t* text = GetTblEntryByIndex(id, TBLOFFSET_STRING);
+		if (!text) { continue; }
+		std::wstring label = StatRangeLabel(text, wcslen(text));
+		if (label.size() >= 4 && actual.find(label) != std::wstring::npos) { return true; }
+	}
+	return false;
+}
