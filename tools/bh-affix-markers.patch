+static void AppendAffixMarkers(UnitAny* pItem, wchar_t* wTxt)
+{
+	if (!pItem || !pItem->pItemData || !wTxt) { return; }
+	int awakened = ItemGetAwakener(pItem);
+	int corrupted = ItemGetCorruptor(pItem, STAT_CORRUPTED);
+	int legacy = ItemGetCorruptor(pItem, STAT_UNUSED205);
+	if (awakened < 0 && corrupted < 0 && legacy < 0) { return; }
+
+	auto* table = *p_D2COMMON_sgptDataTable;
+	const std::wstring colors[] = { GetColorCode(TextColor::Gold), GetColorCode(TextColor::Red), GetColorCode(TextColor::Orange) };
+	for (size_t start = 0; wTxt[start]; )
+	{
+		size_t end = start;
+		while (wTxt[end] && wTxt[end] != L'\n') { ++end; }
+		size_t labelEnd = end;
+		bool excluded = false;
+		bool present[3] = {};
+		for (size_t k = start; k < end; ++k)
+		{
+			if (wTxt[k] == 0xFF && k + 2 < end && wTxt[k + 1] == L'c')
+			{
+				for (int c = 0; c < 3; ++c)
+				{
+					if (k + 3 < end && wTxt[k + 2] == colors[c][2] && wTxt[k + 3] == L'*') { present[c] = true; }
+				}
+				k += 2;
+				continue;
+			}
+			if (wTxt[k] == L':' || wTxt[k] == L'\r') { excluded = true; }
+			if (wTxt[k] == L'[' && labelEnd == end) { labelEnd = k; }
+		}
+		bool marked[3] = {};
+		if (!excluded)
+		{
+			for (DWORD stat = 0; stat < table->dwItemStatCostRecs; ++stat)
+			{
+				bool candidate[] = { StatIsCorrupted(stat, legacy) != FALSE, StatIsCorrupted(stat, corrupted) != FALSE, StatIsAwakened(stat, awakened) != FALSE };
+				if (!candidate[0] && !candidate[1] && !candidate[2]) { continue; }
+				// Exact labels keep "Damage Reduced" distinct from "Magic Damage Reduced".
+				if (!StatRangeLineMatches((WORD)stat, wTxt + start, labelEnd - start, true)) { continue; }
+				for (int c = 0; c < 3; ++c) { marked[c] = marked[c] || candidate[c]; }
+			}
+		}
+		std::wstring resume = GetColorCode(TextColor::Blue);
+		for (size_t k = end; k >= 3; --k)
+		{
+			if (wTxt[k - 3] == 0xFF && wTxt[k - 2] == L'c') { resume.assign(wTxt + k - 3, 3); break; }
+		}
+		std::wstring suffix;
+		for (int c = 0; c < 3; ++c)
+		{
+			if (marked[c] && !present[c]) { suffix += colors[c] + L"*" + resume; }
+		}
+		size_t total = wcslen(wTxt);
+		if (!suffix.empty() && total + suffix.size() < ITEM_TEXT_SIZE_LIMIT)
+		{
+			memmove(wTxt + end + suffix.size(), wTxt + end, (total - end + 1) * sizeof(wchar_t));
+			wmemcpy(wTxt + end, suffix.c_str(), suffix.size());
+			end += suffix.size();
+		}
+		start = wTxt[end] ? end + 1 : end;
+	}
+}
